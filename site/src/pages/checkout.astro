---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
---
<Layout title="Checkout | Mecosin"><section class="page-intro section-wrap"><p class="section-label">02 / 02</p><h1><T id="Lengkapi pilihan Anda." en="Complete your selection." /></h1><p><T id="Tidak ada pesanan atau pembayaran. Jangan masukkan data pribadi. Gunakan identitas contoh di bawah." en="No order or payment. Do not enter personal data. Use the sample identity below." /></p></section><section class="section-wrap journey"><div><div id="checkout-empty" hidden><h2><T id="Tambahkan produk lebih dahulu." en="Add a product first." /></h2><a class="button" href="/produk/"><T id="Lihat katalog" en="Browse catalog" /></a></div><form id="checkout-form" method="dialog" autocomplete="off"><fieldset disabled><legend><T id="Tujuan contoh" en="Sample destination" /></legend><label><T id="Identitas contoh" en="Sample identity" /><select id="demo-person" required><option value="" data-id="Pilih identitas contoh" data-en="Choose a sample identity">Pilih identitas contoh</option><option value="visitor" data-id="Pengunjung contoh (fiktif)" data-en="Sample visitor (fictional)">Pengunjung contoh (fiktif)</option></select></label><label><T id="Alamat contoh" en="Sample address" /><select id="demo-address" required><option value="" data-id="Pilih alamat contoh" data-en="Choose a sample address">Pilih alamat contoh</option><option value="sample" data-id="Alamat fiktif · Kota contoh" data-en="Fictional address · Sample city">Alamat fiktif · Kota contoh</option></select></label><label><T id="Metode pembayaran simulasi" en="Simulated payment method" /><select id="demo-payment" required><option value="" data-id="Pilih metode simulasi" data-en="Choose a simulated method">Pilih metode simulasi</option><option value="transfer" data-id="Transfer bank · simulasi" data-en="Bank transfer · simulation">Transfer bank · simulasi</option><option value="wallet" data-id="Dompet digital · simulasi" data-en="Digital wallet · simulation">Dompet digital · simulasi</option></select></label><p class="fine"><T id="Alamat di atas fiktif, bukan alamat kirim. Tidak ada nomor rekening, QR, kartu, PIN, atau kredensial yang diminta." en="The address above is fictional, not a delivery address. No account number, QR code, card, PIN, or credentials requested." /></p><label class="check"><input id="demo-consent" type="checkbox" required /><span><T id="Saya mengerti ini simulasi, bukan pesanan." en="I understand this is a simulation, not an order." /></span></label><button class="button" type="submit"><T id="Selesaikan simulasi" en="Complete simulation" /></button></fieldset></form><section id="completion" class="panel" hidden tabindex="-1"><h2><T id="Simulasi selesai. Bukan pesanan." en="Simulation complete. Not an order." /></h2><p><T id="Tidak ada pembayaran, pengiriman, atau data yang dikirim. Keranjang dikosongkan. Pilihan checkout tidak disimpan." en="No payment, delivery, or data transmission occurred. Cart cleared. Checkout selections were not saved." /></p><a class="button" href="/produk/"><T id="Kembali ke katalog" en="Back to catalog" /></a><a class="text-link" href="/loyalitas/"><T id="Lihat contoh loyalitas" en="Explore loyalty example" /></a></section></div><aside class="summary panel"><h2><T id="Ringkasan belanja" en="Cart summary" /></h2><div data-totals></div><label class="check"><input type="checkbox" id="demo-promo" /><span><T id="Gunakan diskon 10%" en="Apply 10% discount" /></span></label><a class="text-link" href="/keranjang/"><T id="Ubah keranjang" en="Edit cart" /></a></aside></section></Layout>
