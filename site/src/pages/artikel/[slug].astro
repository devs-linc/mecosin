---
import Layout from '../../layouts/Layout.astro';
import T from '../../components/T.astro';
import articles from '../../data/articles.json';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
---
<Layout title={`${article.title_en} | Mecosin archive`}><article class="section-wrap article-detail"><a class="text-link" href="/artikel/"><T id="← Artikel & kegiatan" en="← Articles & activities" /></a><p class="section-label"><T id="Arsip sumber · 5 Agustus 2024" en="Source archive · 5 August 2024" /></p><h1><T id={article.title_id} en={article.title_en} /></h1><img class="rounded" src={article.image} alt={article.title_en} width="1000" height="563" /><p class="fine"><T id="Foto: arsip situs Mecosin. Bukan bukti dukungan medis, akreditasi atau kemitraan aktif." en="Photo: Mecosin website archive. Not evidence of medical endorsement, accreditation or an active partnership." /></p><div class="prose"><h2><T id="Kutipan sumber" en="Source excerpts" /></h2>{article.excerpts.map(text=><blockquote lang="en">{text}</blockquote>)}<p class="notice"><T id="Kutipan dipilih dari artikel asli dan dipertahankan dalam Bahasa Inggris. Ini arsip kegiatan, bukan saran medis atau konfirmasi status kerja sama saat ini. Tidak ada penulis atau peninjau medis rekaan." en="Selected excerpts retain the original English. This is an activity archive, not medical advice or confirmation of current partnership status. No invented author or medical reviewer." /></p><a class="source-link" href={article.source} rel="noreferrer"><T id="Baca sumber Mecosin ↗" en="Read the Mecosin source ↗" /></a><a class="button" href="/artikel/"><T id="Kembali ke arsip" en="Back to archive" /></a></div></article></Layout>
