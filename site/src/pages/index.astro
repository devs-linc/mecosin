---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
const brands=['Laserin','MecoVit','Lancar ASI','Mecowell','Herbatusauda','Beauty 360'];
const covers=['laserin-dewasa','mecovit-immune-bocah-sehat','lancar-asi','mecowell-normoten','herbatusauda','beauty-360-body-serum'];
---
<Layout>
<section class="hero" aria-label="Mecosin introduction video"><div class="film-frame"><img class="hero-poster" src="/media/company-poster.webp" width="1280" height="720" alt="Microscope in Mecosin introduction / Mikroskop dalam video pengantar Mecosin" fetchpriority="high" /><video id="hero-video" data-src="/media/company-hero.mp4" muted loop playsinline preload="none" aria-label="Silent company introduction video"></video></div></section>
<div class="video-control-bar section-wrap"><button id="video-toggle" aria-controls="hero-video" hidden aria-label="Pause video"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path class="pause-mark" d="M4 3v10M12 3v10" stroke="currentColor" stroke-width="3"/><path class="play-mark" d="M4 2l10 6-10 6z" fill="currentColor"/></svg></button></div><section class="home-intro section-wrap"><div><p class="eyebrow">Mecosin Indonesia · <T id="Sejak 1961" en="Since 1961" /></p><h1><T id="Dekat dengan keluarga Anda." en="Closer to your everyday life." /></h1></div><div><p><T id="Kenali produk herbal, suplemen, dan perawatan tubuh dalam portofolio Mecosin." en="Explore herbal products, supplements and body care in the Mecosin portfolio." /></p><p><T id="Mulai dari merek yang Anda kenal, lalu telusuri rangkaian produk dan informasi pada setiap halaman." en="Start with a familiar brand, then explore its range and the information on each product page." /></p><div class="actions"><a class="button" href="/produk/"><T id="Jelajahi produk ↗" en="Explore products ↗" /></a><a class="text-link" href="/kemitraan/"><T id="Untuk mitra bisnis ↗" en="For business partners ↗" /></a></div></div></section>
<section id="merek" class="brand-discovery section-wrap"><div class="section-heading centered"><p class="section-label"><T id="Pilihan untuk keseharian" en="Explore the portfolio" /></p><h2><T id="Mulai dari merek yang Anda kenal" en="Start with a familiar name" /></h2></div><div class="brand-shortcuts">{brands.map((brand,i)=><a href={`/produk/?merek=${encodeURIComponent(brand)}`}><span class={`brand-circle tone-${i}`}><img src={`/images/${covers[i]}.webp`} width="240" height="240" alt={brand} loading="lazy" /></span><span>{brand}</span></a>)}</div></section>
<section class="product-banners section-wrap">{[['Laserin','laserin-dewasa','Sudah kenal. Kenali lebih dekat.','A familiar name. A closer look.'],['MecoVit','mecovit-immune-bocah-sehat','Kenali rangkaian suplemen.','Explore the supplement range.']].map(([brand,image,id,en],i)=><article class={`product-banner ${i?'mecovit-banner':'laserin-banner'}`}><div><p class="section-label">{brand}</p><h2><T id={id} en={en} /></h2><p><T id="Lihat kemasan dan baca informasi katalog Mecosin." en="View the packaging and read Mecosin catalog information." /></p><a class="text-link" href={`/produk/?merek=${brand}`}><T id="Jelajahi koleksi ↗" en="Explore collection ↗" /></a></div><img src={`/images/${image}.webp`} alt={brand} width="640" height="640" loading="lazy" /></article>)}</section>
<section id="katalog" class="section-wrap featured"><div class="section-heading"><h2><T id="Kenali produknya." en="Meet the products." /></h2><a class="text-link" href="/produk/"><T id="Lihat 20 produk ↗" en="View all 20 products ↗" /></a></div><div class="product-grid">{['laserin-dewasa','mecovit-c-500-mg','lancar-asi','beauty-360-body-serum'].map(slug=><ProductCard product={products.find(p=>p.slug===slug)} />)}</div></section>
<section id="tentang" class="about section-wrap"><figure class="story-image"><img src="/images/team.webp" alt="Tim Mecosin / Mecosin team" width="1500" height="1005" loading="lazy" /><figcaption>Mecosin Indonesia</figcaption></figure><div class="story-copy"><p class="section-label"><T id="Perjalanan kami" en="Our story" /></p><h2><T id="Bersama Indonesia sejak 1961." en="With Indonesia since 1961." /></h2><p><T id="Mecosin berdiri pada 1961. Kenali sejarah dan orang-orang di balik perusahaan." en="Mecosin was founded in 1961. Discover the history and people behind the company." /></p><p><T id="Baca kisah perusahaan, visi yang menjadi arah usahanya, dan kegiatan yang tercatat dalam perjalanan Mecosin." en="Read about the company’s beginnings, the vision behind its work and the activities recorded throughout its journey." /></p><a class="outline-button" href="/perusahaan/"><T id="Kenali Mecosin ↗" en="Meet Mecosin ↗" /></a></div></section>
<section id="kemitraan" class="partnership section-wrap"><div class="story-copy"><p class="section-label"><T id="Untuk mitra bisnis" en="For business partners" /></p><h2><T id="Mulai dari kebutuhan bisnis Anda." en="Start with your business needs." /></h2><p><T id="Jelajahi layanan manufaktur, pengelolaan pasar, dan importasi bersama Mecosin." en="Explore manufacturing, market management and importation with Mecosin." /></p><p><T id="Pelajari cakupan layanan sebelum membicarakan kebutuhan produk, pasar, dan wilayah bisnis Anda dengan tim Mecosin." en="Learn about the service areas before discussing your product, market and regional requirements with the Mecosin team." /></p><a class="button" href="/kemitraan/"><T id="Jelajahi kemitraan ↗" en="Explore partnerships ↗" /></a></div><img class="rounded" src="/images/services.webp" alt="Tim layanan Mecosin / Mecosin services team" width="1080" height="618" loading="lazy" /></section>
<section id="belanja" class="shop-band"><div class="section-wrap"><div><p class="section-label"><T id="Informasi untuk Anda" en="Here to help" /></p><h2><T id="Kenali produk lebih dekat." en="Get to know our products." /></h2><p><T id="Temukan informasi produk, baca artikel Mecosin, atau pilih pertanyaan yang ingin Anda pelajari." en="Find product information, read Mecosin articles or explore common questions." /></p></div><div class="shop-links"><a class="button" href="/bantuan/"><T id="Informasi produk" en="Product information" /></a><a class="outline-button" href="/artikel/"><T id="Artikel & edukasi" en="Articles & education" /></a></div></div></section>
<section id="kontak" class="section-wrap contact"><h2><T id="Butuh informasi resmi?" en="Need official information?" /></h2><a class="text-link" href="/perusahaan/#kontak"><T id="Lihat kontak Mecosin ↗" en="View Mecosin contacts ↗" /></a></section>
</Layout>
