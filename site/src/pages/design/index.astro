---
import Layout from '../../layouts/Layout.astro';
const options=[
 {slug:'hybrid',number:'01',title:'Heritage & science',description:'Botanical heritage, product discovery, company journey and business partnerships.',image:'/images/design-preview-hybrid.webp',sections:'9 sections + footer'},
 {slug:'consumer',number:'02',title:'Everyday wellness',description:'A light, product-first homepage with brand discovery, information guide and editorial stories.',image:'/images/design-preview-consumer.webp',sections:'11 sections + footer'},
 {slug:'business',number:'03',title:'Business partnership',description:'Manufacturing, product expertise, company people and a clear partnership journey.',image:'/images/design-preview-business.webp',sections:'12 sections + footer'},
];
---
<Layout title="Homepage design options | Mecosin"><section class="design-hub section-wrap"><p class="section-label">Linc × Mecosin</p><h1>Three homepages.<br/>One Mecosin.</h1><p class="design-lead">Three distinct layouts following your references, with Mecosin products, photographs and company content. Open each option to explore the complete homepage.</p><div class="design-options">{options.map(option=><article><a class="design-preview" href={`/design/${option.slug}/`}><img src={option.image} alt={`${option.title} homepage preview`} width="900" height="680" loading="lazy"/></a><div><span>{option.number} · {option.sections}</span><h2>{option.title}</h2><p>{option.description}</p><a class="button" href={`/design/${option.slug}/`}>Open homepage <span aria-hidden="true">↗</span></a></div></article>)}</div></section></Layout>
<style>.design-hub{padding-top:55px;padding-bottom:70px}.design-hub h1{font-size:clamp(40px,5vw,64px)}.design-lead{max-width:750px;margin:25px 0 40px;color:var(--muted);font-size:17px}.design-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.design-options article{border:1px solid var(--line);border-radius:15px;overflow:hidden;min-width:0}.design-preview{display:block;height:295px;background:#edf2e8;overflow:hidden}.design-preview img{width:100%;height:100%;object-fit:cover;object-position:top}.design-options article>div{padding:25px}.design-options article>div>span{font-size:11px;color:var(--muted)}.design-options h2{font-size:29px;margin:15px 0}.design-options p{color:var(--muted);font-size:14px;min-height:72px;margin-bottom:22px}.design-options .button{font-size:12px}@media(max-width:1000px){.design-options{grid-template-columns:1fr}.design-preview{height:360px}.design-options article{display:grid;grid-template-columns:1fr 1fr}.design-options article>div{align-self:center}}@media(max-width:640px){.design-hub{padding-top:35px}.design-options article{display:block}.design-preview{height:280px}.design-options article>div{padding:24px}.design-options p{min-height:0}}</style>
