---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import products from '../data/products.json';
---
<Layout title="Product information | Mecosin"><section class="page-intro section-wrap"><p class="section-label"> <T id="Bukan AI atau tenaga kesehatan" en="Not AI or a healthcare professional" /></p><h1><T id="Apa yang ingin Anda ketahui?" en="What would you like to know?" /></h1><p><T id="Pilih pertanyaan yang sudah disiapkan. Chat tidak menganalisis gejala, memberi dosis, diagnosis atau rekomendasi pribadi. Tidak ada data percakapan yang disimpan." en="Choose a prepared question. Chat does not assess symptoms, provide dosage, diagnosis or personal recommendations. Conversation data is not stored." /></p></section><section class="section-wrap journey"><div class="panel chat-panel"><div id="chat-log" role="log" aria-live="polite"><p class="chat-bubble"><T id="Pilih produk atau topik untuk membaca informasi yang tersedia." en="Choose a product or topic to read the available information." /></p></div><label><T id="Pilih produk untuk membaca katalog" en="Choose a product to read its catalog excerpt" /><select id="chat-product"><option value="" data-id="Pilih produk" data-en="Choose a product">Pilih produk</option>{products.map(p=><option value={p.slug}>{p.name}</option>)}</select></label><div class="chat-choices"><button data-chat="product" disabled><T id="Informasi produk" en="Product information" /></button><button data-chat="safety" disabled><T id="Dosis, gejala & keamanan" en="Dosage, symptoms & safety" /></button><button data-chat="certification" disabled><T id="BPOM / Halal" en="BPOM / Halal" /></button><button data-chat="partnership" disabled><T id="Pertanyaan kemitraan" en="Partnership enquiry" /></button><button data-chat="order" disabled><T id="Pesanan & pembayaran" en="Orders & payment" /></button><button id="chat-reset" disabled><T id="Bersihkan chat" en="Clear chat" /></button></div></div><aside class="prose"><h2><T id="Tentang informasi ini" en="About this information" /></h2><p><T id="Tidak ada analisis AI, konsultasi langsung, atau penilaian kecocokan produk. Balasan hanya informasi produk dan navigasi." en="No AI analysis, live consultation or product suitability assessment. Replies cover product information and navigation only." /></p><p><T id="Untuk pertanyaan kesehatan, interaksi obat, penggunaan pada anak, kehamilan atau menyusui, bicarakan dengan dokter atau apoteker. Bila gejala berat atau darurat, segera cari pertolongan medis." en="For health questions, medicine interactions, use in children, pregnancy or breastfeeding, speak with a doctor or pharmacist. Seek immediate medical help for severe symptoms or emergencies." /></p><a class="text-link" id="chat-partner-link" href="/kemitraan/#form"><T id="Buka pratinjau pertanyaan B2B" en="Open B2B enquiry preview" /></a><p class="fine"><T id="Ringkasan chat hanya berupa topik tetap di URL, bukan percakapan atau data pribadi." en="Chat summary transfers only a fixed topic in the URL, not conversation text or personal data." /></p><a class="text-link" href="/perusahaan/#kontak"><T id="Kontak resmi Mecosin" en="Official Mecosin contacts" /></a></aside></section></Layout>
