---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
import ProductCard from '../../components/ProductCard.astro';
import Rating from '../../components/Rating.astro';
import '../../styles/shopping.css';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const related=products.filter(p=>p.brand===product.brand&&p.slug!==product.slug).slice(0,3);
const pack=product.slug==='laserin-sachet'?'15 ml × 10 sachet':'Kemasan sesuai katalog';
---
<Layout shopping title={`${product.name} | Mecosin`} description={`Kemasan dan informasi ${product.name}. Harga dan checkout simulasi.`}>
<div class="shop-detail section-wrap">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/produk/">Produk</a><span>/</span><span>{product.name}</span></nav>
<article class="shop-detail-top" data-product-detail data-slug={product.slug}>
<div class="shop-gallery"><img src={product.image} alt={product.name} width="640" height="640" fetchpriority="high"/><small>Kemasan asli Mecosin · 1 foto</small></div>
<div class="shop-overview"><p class="shop-brand">{product.brand}</p><h1>{product.name}</h1><Rating /><div class="shop-product-tools"><a href="#ulasan" class="shop-review-link">Lihat ulasan</a><button type="button" data-favourite aria-pressed="false" aria-label="Sukai produk">♡</button><button type="button" data-share>Bagikan</button></div><p data-share-status role="status" class="shop-sample-note"></p><p class="shop-price">Rp25.000 <small>per kemasan</small></p><p class="shop-sample-note">Harga, rating dan terjual contoh desain, bukan penawaran aktif.</p>
<div class="shop-shipping"><h2>Pengiriman</h2><strong>Estimasi tiba: 2–4 hari kerja</strong><p>Ongkir contoh Rp10.000 · Reguler</p><p class="shop-sample-note">Contoh estimasi, bukan janji pengiriman. Alamat dan kurir menentukan hasil.</p><a class="shop-button outline" href="/checkout/#alamat">Pilih alamat pengiriman</a></div>
<fieldset class="shop-pack"><legend>Pilih kemasan</legend><label><input type="radio" name="kemasan" value="catalog" checked/> {pack}</label></fieldset>
</div>
<aside class="shop-purchase"><h2>Atur jumlah pembelian</h2><p>{pack}</p><label for="product-quantity">Jumlah</label><input id="product-quantity" type="number" min="1" max="99" step="1" value="1" inputmode="numeric"/><div class="shop-subtotal"><span>Subtotal</span><strong data-detail-subtotal>Rp25.000</strong></div><button class="shop-button outline" data-add={product.slug} data-use-quantity disabled>Tambah ke keranjang</button><button class="shop-button" data-add={product.slug} data-buy-now data-use-quantity disabled>Beli sekarang</button><p class="shop-sample-note">Stok belum terhubung.</p></aside>
</article>
<div class="shop-store"><div><h2>Mecosin Indonesia</h2><p>Produk {product.brand} dari katalog Mecosin.</p></div><a class="shop-button outline" href={`/produk/?merek=${encodeURIComponent(product.brand)}`}>Lihat produk brand</a></div>
<section class="shop-panel" id="ulasan" data-detail-section="reviews"><h2>Ulasan pembeli</h2><div class="shop-review-summary"><div><strong>4.8 / 5</strong><Rating sold="Contoh metrik"/></div><div class="shop-review-filters"><button type="button" aria-pressed="true" data-review-filter>Semua</button><button type="button" aria-pressed="false" data-review-filter>5 bintang</button><button type="button" aria-pressed="false" data-review-filter>4 bintang</button><button type="button" aria-pressed="false" data-review-filter>Foto/video</button></div></div><p id="review-result" role="status">Belum ada ulasan pembeli aktual. Komentar dan foto/video tampil setelah data tersedia.</p></section>
<section class="shop-panel" data-detail-section="specifications"><h2>Spesifikasi produk</h2><dl class="shop-specs"><dt>Nama produk</dt><dd>{product.name}</dd><dt>Brand</dt><dd>{product.brand}</dd><dt>Isi kemasan</dt><dd>{pack}</dd><dt>Nomor izin edar</dt><dd>Periksa label resmi produk.</dd></dl></section>
<section class="shop-panel" data-detail-section="description"><h2>Deskripsi produk</h2><blockquote>{product.excerpt}</blockquote><a class="source-link" href={product.originalDetail} target="_blank" rel="noreferrer">Sumber: katalog Mecosin ↗</a>{product.excerpt.includes('...')&&<p>Deskripsi sumber terpotong; baca sumber untuk informasi lengkap.</p>}<p class="shop-sample-note">Baca label dan peringatan kemasan. Tanyakan apoteker atau dokter untuk dosis, kecocokan, interaksi obat, kehamilan dan penggunaan pada anak. Bukan saran medis.</p></section>
{related.length>0&&<section class="shop-related"><h2>Produk {product.brand} lainnya</h2><div class="product-grid">{related.map(p=><ProductCard product={p}/>)}</div></section>}
<div class="shop-mobile-purchase"><a href="/bantuan/">Bantuan</a><button class="shop-button outline" data-add={product.slug} data-use-quantity disabled>+ Keranjang</button><button class="shop-button" data-add={product.slug} data-buy-now data-use-quantity disabled>Beli sekarang</button></div>
</div>
</Layout>