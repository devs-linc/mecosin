---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
import ProductCard from '../../components/ProductCard.astro';
import T from '../../components/T.astro';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const related=products.filter(p=>p.brand===product.brand&&p.slug!==product.slug).slice(0,3);
---
<Layout title={`${product.name} | Mecosin`} description={`Kemasan dan kutipan katalog ${product.name}. Harga dan checkout hanya simulasi.`}><div class="detail-wrap section-wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/"><T id="Beranda" en="Home" /></a><span>/</span><a href="/produk/"><T id="Produk" en="Products" /></a><span>/</span><span>{product.name}</span></nav><article class="detail-grid"><div class="detail-visual"><img src={product.image} alt={product.name} width="640" height="640" fetchpriority="high" /></div><div class="detail-copy"><p class="section-label">{product.brand}</p><h1>{product.name}</h1><p class="demo-price">Rp25.000</p><button class="button" data-add={product.slug} disabled><T id="Tambah ke keranjang" en="Add to cart" /></button><a class="text-link" href="/keranjang/"><T id="Lihat keranjang" en="View cart" /></a><div class="source-panel"><h2 class="detail-information"><T id="Kutipan katalog Mecosin" en="Mecosin catalog excerpt" /></h2><blockquote lang="id">{product.excerpt}</blockquote><a class="source-link" href={product.source}><T id="Sumber: katalog resmi ↗" en="Source: official catalog ↗" /></a><p class="fine"><T id="Kutipan sumber dipertahankan dalam Bahasa Indonesia, bukan saran medis atau validasi klinis." en="Source excerpt retained in Indonesian; not medical advice or clinical validation." /></p>{product.excerpt.includes('...')&&<p class="fine"><T id="Deskripsi sumber terpotong. Informasi lengkap belum tersedia." en="Source description is truncated. Complete information is not available here." /></p>}</div><p class="safety-note"><T id="Baca label dan peringatan kemasan. Dosis, interaksi obat, kehamilan, penggunaan pada anak dan kecocokan pribadi perlu ditanyakan kepada apoteker atau dokter." en="Read the package label and warnings. Ask a pharmacist or doctor about dosage, interactions, pregnancy, use in children and personal suitability." /></p><a class="text-link" href="/bantuan/"><T id="Buka informasi produk" en="Open product information" /></a></div></article><section class="detail-more service-list"><h2><T id="Kenali sebelum memilih" en="Learn before choosing" /></h2><details><summary><T id="Lihat kemasan lebih dekat" en="See the packaging up close" /><span>+</span></summary><img class="pack-zoom" src={product.image} alt={product.name} width="640" height="640" loading="lazy" /><p><T id="Foto kemasan asli dari situs Mecosin. Model 3D dan visual bagian dalam produk belum tersedia; tidak dibuat ulang sebagai fakta." en="Original packaging image from Mecosin. 3D models and internal product visuals are unavailable; no invented views are presented as fact." /></p></details><details><summary><T id="Komposisi, dosis & sertifikasi" en="Ingredients, dosage & certification" /><span>+</span></summary><p><T id="Label lengkap dan dokumen sertifikasi terverifikasi belum tersedia di sini. Periksa kemasan atau tanyakan kepada Mecosin. Bantuan ini tidak memberikan dosis atau jaminan keamanan." en="Complete labels and verified certification documents are unavailable here. Check the package or ask Mecosin. This guide does not provide dosage or safety assurances." /></p></details><details><summary><T id="Ulasan & testimoni" en="Reviews & testimonials" /><span>+</span></summary><p><T id="Ulasan pelanggan dan persetujuan publikasi belum tersedia. Tidak ada ulasan contoh yang disajikan sebagai pengalaman nyata." en="Customer reviews and publication consent are unavailable. No sample reviews are presented as real experiences." /></p></details></section>{related.length>0&&<section class="detail-more"><h2><T id="Dalam koleksi yang sama" en="In the same collection" /></h2><div class="product-grid">{related.map(p=><ProductCard product={p} />)}</div></section>}</div></Layout>
