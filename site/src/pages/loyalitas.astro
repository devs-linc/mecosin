---
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
---
<Layout title="Loyalty | Mecosin"><section class="page-intro section-wrap"><p class="section-label"><T id="Bukan program resmi" en="Not an official program" /></p><h1><T id="Kembali, kenali lebih banyak." en="Come back, discover more." /></h1><p><T id="Contoh antarmuka loyalitas. Tidak ada akun, poin nyata, hadiah atau hak penukaran." en="A loyalty interface example. No account, real points, rewards or redemption entitlement." /></p></section><section class="section-wrap journey"><div class="panel loyalty-card"><p>MECOSIN</p><h2><T id="Pengunjung contoh" en="Sample visitor" /></h2><strong class="points">120</strong><p><T id="poin fiktif · tidak dapat ditukar" en="fictional points · not redeemable" /></p><label><T id="Simulasikan nilai belanja" en="Simulate a purchase amount" /><select id="loyalty-amount"><option value="50000">Rp50.000</option><option value="100000">Rp100.000</option><option value="200000">Rp200.000</option></select></label><button id="loyalty-try" class="button" disabled><T id="Hitung poin contoh" en="Calculate example points" /></button><p id="loyalty-result" role="status"></p></div><div class="prose"><h2><T id="Cara kerja contoh" en="How this example works" /></h2><p><T id="Aturan fiktif: 1 poin untuk setiap Rp10.000 nilai belanja simulasi. Saldo 120 hanya contoh tampilan dan tidak berubah setelah checkout." en="Fictional rule: 1 point per Rp10,000 of simulated spending. The 120 balance is a display example and does not change after checkout." /></p><details><summary><T id="Contoh hadiah" en="Example reward" /></summary><p><T id="200 poin fiktif untuk voucher simulasi Rp20.000. Tidak dapat digunakan, tidak ada kupon yang diterbitkan." en="200 fictional points for a simulated Rp20,000 voucher. Not usable; no coupon is issued." /></p></details><h3><T id="Harga & promo contoh" en="Example prices & promotions" /></h3><p><T id="Semua unit berharga Rp25.000. Diskon 10% di keranjang/checkout memperagakan diskon 10%. Paket eksklusif dan harga nyata menunggu persetujuan; tidak ada penawaran bundel resmi." en="Every unit costs Rp25,000. The cart/checkout discount demonstrates a 10% discount. Exclusive bundles and real prices await approval; no official bundle is offered." /></p><a class="button" href="/produk/"><T id="Jelajahi katalog" en="Explore the catalog" /></a></div></section></Layout>
