---
import '../styles/site.css';
import '../styles/demo.css';
import '../styles/navigation.css';
import T from '../components/T.astro';
const { title = 'Mecosin Indonesia | Since 1961', description = 'Explore herbal products, supplements, body care and business partnerships with PT Mecosin Indonesia.' } = Astro.props;
const links = [['/produk/','Produk','Products'],['/perusahaan/','Perusahaan','Company'],['/kemitraan/','Kemitraan','Partnerships'],['/artikel/','Edukasi','Education']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="robots" content="noindex, nofollow" /><meta name="theme-color" content="#eff7e9" /><title>{title}</title><link rel="icon" href="/images/logo.webp" type="image/webp" /></head><body>
<a class="skip" href="#main"><T id="Langsung ke konten" en="Skip to content" /></a>
<header class="site-header" id="top">
<div class="utility-nav"><span>PT Mecosin Indonesia</span><a href="/presentation/">Presentation <span aria-hidden="true">↗</span></a><label class="language-control" hidden><span class="sr-only">Language / Bahasa</span><select id="language"><option value="en">EN · English</option><option value="id">ID · Indonesia</option></select></label></div>
<div class="primary-nav"><a class="brand" href="/" aria-label="Mecosin home"><img src="/images/logo.webp" alt="Mecosin" width="600" height="75" /></a>
<button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" hidden>Menu <span aria-hidden="true">☰</span></button>
<nav id="main-nav" aria-label="Main navigation"><a href="/"><T id="Beranda" en="Home" /></a><details class="company-nav"><summary><T id="Tentang Kami" en="About Us" /><span aria-hidden="true">⌄</span></summary><div class="company-menu">{[['/about/','Profil Kami','Who We Are'],['/products/','Produk Kami','Our Products'],['/services/','Layanan Kami','Our Services'],['/team/','Tim Kami','Our Team'],['/partners/','Mitra Kami','Our Partner']].map(([href,id,en])=><a href={href}><T id={id} en={en} /><span aria-hidden="true">↗</span></a>)}</div></details><a href="/discoveries/"><T id="Keberlanjutan" en="Sustainability" /></a><a href="/articles/"><T id="Kegiatan & Artikel" en="Activities & Articles" /></a><a href="/career/"><T id="Berkembang Bersama" en="Grow With Us" /></a></nav>
<a href="/keranjang/" class="cart-trigger" data-open-cart aria-haspopup="dialog" aria-controls="cart-drawer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg><span class="sr-only"><T id="Keranjang" en="Cart" /></span><span data-cart-count>0</span></a></div></header>
<main id="main"><noscript><p class="notice section-wrap">JavaScript nonaktif: katalog, halaman dan tautan tetap tersedia. Keranjang, checkout, pilihan bahasa dan pratinjau formulir memerlukan JavaScript; tidak ada formulir yang dikirim. / JavaScript is off: browsing works; interactive demos are disabled.</p></noscript><slot /></main>
<div id="cart-status" class="toast" role="status" aria-live="polite"></div>
<dialog id="cart-drawer" aria-labelledby="cart-drawer-title">
  <div class="drawer-head"><div><p class="section-label"><T id="Pilihan Anda" en="Your selection" /></p><h2 id="cart-drawer-title"><T id="Keranjang" en="Your cart" /></h2></div><button class="drawer-close" type="button" data-close-cart autofocus><span aria-hidden="true">×</span><span class="sr-only"><T id="Tutup keranjang" en="Close cart" /></span></button></div>
  <div class="drawer-body"><div data-cart-items></div><div data-drawer-empty class="drawer-empty"><h3><T id="Keranjang masih kosong." en="Your cart is empty." /></h3><p><T id="Temukan produk yang ingin Anda kenali." en="Find a product you would like to explore." /></p><a class="button" href="/produk/"><T id="Jelajahi produk" en="Explore products" /></a></div></div>
  <div class="drawer-foot" data-drawer-filled hidden><div class="drawer-subtotal"><span>Subtotal</span><strong data-cart-subtotal></strong></div><a class="button" href="/keranjang/"><T id="Lihat keranjang" en="View cart" /><span aria-hidden="true">↗</span></a><button class="drawer-continue" type="button" data-close-cart><T id="Lanjut jelajahi produk" en="Continue browsing" /></button></div>
</dialog>
<footer class="site-footer"><div class="footer-brand"><a class="brand" href="/"><img src="/images/logo.webp" alt="Mecosin" width="600" height="75" loading="lazy" /></a><p>PT Mecosin Indonesia</p><small><T id="Herbal, obat, dan suplemen. Sejak 1961." en="Herbal products, medicines and supplements. Since 1961." /></small></div><nav aria-label="Company directory"><h2><T id="Kenali Mecosin" en="Meet Mecosin" /></h2>{links.slice(1).map(([href,id,en])=><a href={href}><T id={id} en={en} /></a>)}<a href="/perusahaan/#kontak"><T id="Kontak resmi" en="Official contacts" /></a></nav><nav aria-label="Shopping directory"><h2><T id="Jelajahi Mecosin" en="Explore Mecosin" /></h2><a href="/produk/"><T id="Katalog produk" en="Product catalog" /></a><a href="/loyalitas/"><T id="Loyalitas" en="Loyalty" /></a><a href="/bantuan/"><T id="Informasi produk" en="Product information" /></a></nav><div class="footer-source"><h2><T id="Frontend demo" en="Frontend demo" /></h2><p><T id="Website ini untuk pratinjau desain, bukan toko aktif. Harga Rp25.000 per unit, diskon 10%, ongkir Rp10.000, pajak Rp0, serta poin dan hadiah hanya contoh, bukan penawaran resmi. Stok belum terhubung. Tidak ada pesanan, akun, pembayaran atau pengiriman data pribadi. Chat memakai jawaban yang sudah disiapkan, bukan AI atau konsultasi. Video bukan tur fasilitas terverifikasi." en="This website is a design preview, not an active store. Rp25,000 unit prices, 10% discounts, Rp10,000 shipping, Rp0 tax, points and rewards are examples, not official offers. Stock is not connected. No orders, accounts, payments or personal data transmission. Chat uses prepared replies, not AI or consultation. Footage is not a verified facility tour." /></p><a class="text-link" href="https://mecosin.id/" rel="noreferrer"><T id="Situs resmi ↗" en="Official website ↗" /></a></div><div class="footer-base"><small><T id="Bukan saran medis. Kutipan sumber tidak diterjemahkan otomatis." en="Not medical advice. Source excerpts are not automatically translated." /></small><a href="#top"><T id="Kembali ke atas ↑" en="Back to top ↑" /></a></div></footer>
<script>import { setup } from '../scripts/site'; setup();</script></body></html>
