---
import Icon from './ReferenceIcon.astro';
import products from '../data/products.json';
import articles from '../data/articles.json';
import AskMecosinCard from './AskMecosinCard.astro';
import ProductCard from './ProductCard.astro';
const { section, variant } = Astro.props;
const business = variant === 'business';
const consumer = variant === 'consumer';
const productSlugs = consumer ? ['laserin-sachet','mecovit-d3-1000-iu','mecovit-c-plus-zinc','herbatusauda','beauty-360-shower-gel'] : ['laserin-dewasa','mecovit-c-500-mg','lancar-asi','herbatusauda','beauty-360-body-serum'];
const featured = productSlugs.map(slug=>products.find(p=>p.slug===slug));
const heroProducts = ['laserin-sachet','laserin-madu-orange','mecovit-d3-1000-iu'].map(slug=>products.find(p=>p.slug===slug));
const transparencyProducts = ['lancar-asi','herbatusauda','mecovit-calci'].map(slug=>products.find(p=>p.slug===slug));
const consumerExplore = [
  {title:'Herbal essentials',description:'Get to know the Laserin range.',slug:'laserin-madu-orange',image:'lifestyle-herbal'},
  {title:'Vitamins & supplements',description:'Explore the MecoVit family.',slug:'mecovit-calci',image:'lifestyle-vitamins'},
  {title:'For mothers & families',description:'Discover Lancar ASI products.',slug:'lancar-asi-plus-dha',image:'lifestyle-family'},
  {title:'Everyday body care',description:'A closer look at Beauty 360.',slug:'beauty-360-body-serum',image:'lifestyle-bodycare'},
].map(item=>({...item,product:products.find(p=>p.slug===item.slug)}));
const concerns = [
 ['Laserin','Everyday herbal care','laserin-dewasa','/images/design/herbs.webp'],
 ['MecoVit','Vitamins & supplements','mecovit-immune-bocah-sehat','/images/botanical.webp'],
 ['Lancar ASI','Explore the product range','lancar-asi','/images/design/sourcing.webp'],
 ['Herbatusauda','Discover herbal products','herbatusauda','/images/ginger.webp'],
 ['Mecowell','Read product information','mecowell-normoten','/images/design/herbs.webp'],
 ['Beauty 360','Body care, every day','beauty-360-body-serum','/images/design/product-family.webp'],
];
const capabilities = [
 ['Toll manufacturing','From development to finished products.','/images/design/manufacturing.webp'],
 ['Product development','Discuss your product and formulation needs.','/images/laboratory-large.webp'],
 ['Market management','Explore support for your business and market.','/images/design/market.webp'],
 ['Importation','Connect products with their destination markets.','/images/design/logistics.webp'],
];
const partners = [['partner-mbs','Mensa Binasukses'],['partner-brin','BRIN'],['partner-pancasila','Universitas Pancasila'],['partner-ugm','Universitas Gadjah Mada'],['partner-umn','Universitas Multimedia Nusantara']];
const steps = [['Business brief','Your product and market needs.'],['Product development','Discuss the product requirements.'],['Registration','Review product registration needs.'],['Manufacturing','Explore manufacturing services.'],['Packaging','Consider the finished product.'],['Warehousing','Discuss storage and distribution.'],['Market support','Plan the next business step.']];
const milestones = [['Our roots','The company story','history-family'],['Laserin','A familiar herbal name','history-laserin'],['Manufacturing','Products and production','history-production'],['Today','People behind the portfolio','history-factory']];
const knowledgeCards = [...articles, {slug:'',title_en:'Explore the Mecosin story',image:'/images/design/herbs.webp'}];
---
{section==='hero' && <section class="ref-hero" data-section="hero">
  {consumer && <picture class="consumer-hero-picture"><source media="(max-width:760px)" srcset="/images/design/consumer-hero-mobile.webp"/><img class="consumer-full-bleed" src="/images/design/consumer-hero-desktop.webp" alt="Illustrative everyday-wellness portrait and botanicals" width="1440" height="650" fetchpriority="high"/></picture>}
  {!consumer && <div class="ref-hero-photo"><img src="/images/design/scientist.webp" alt="Laboratory work in a Mecosin source photograph" width="1440" height="1216" fetchpriority="high"/></div>}
  {!consumer && <img class="ref-hero-herbs" src="/images/design/herbal-hero.webp" alt="Illustrative herbal still life" width="1280" height="720"/>}
  <div class="ref-wrap ref-hero-grid"><div class="ref-hero-copy"><p class="ref-eyebrow">{consumer?'Herbal products & supplements from Indonesia':business?'Indonesian herbal expertise':'Rooted in Indonesia. Since 1961.'}</p>
    <h1>{consumer?<>Closer to your<br/>everyday <em>wellness.</em></>:business?<>Indonesian Herbal<br/>Expertise.<br/>Built for <em>Better<br/>Partnerships.</em></>:<>Natural heritage.<br/>Modern care.<br/><em>Everyday wellbeing.</em></>}</h1>
    <p>{consumer?'Discover familiar Mecosin brands, explore their ingredients, and find official product information.':business?'Manufacturing, product development and market services from Mecosin Indonesia. Start a conversation about your business needs.':'Explore herbal products, supplements and body care from a company whose story began in 1961.'}</p>
    {consumer ? <AskMecosinCard /> : <><div class="ref-actions"><a class="ref-btn gold" href={business?'/kemitraan/':'/produk/'}>{business?'Explore business solutions':'Explore products'}<Icon name="arrow"/></a><a class="ref-btn outline-light" href={business?'/produk/':'/kemitraan/'}>{business?'Mecosin products':'Explore partnership'}<Icon name="arrow"/></a></div><div class="ref-hero-values">{[['leaf','Herbal portfolio'],['flask','Product knowledge'],['globe','Business partnerships']].map(([icon,text])=><div><Icon name={icon}/><span>{text}</span></div>)}</div></>}
  </div>
  {consumer && <div class="ref-consumer-image" aria-hidden="true"></div>}
  </div>
  {consumer && <div class="consumer-hero-composition"><div class="consumer-product-shelf" aria-hidden="true"></div>{heroProducts.map(p=><img class={`hero-pack hero-pack-${p.slug}`} src={p.image} alt={p.name} width="640" height="640"/>)}</div>}
  {business && <div class="ref-wrap ref-business-strip"><a href="/kemitraan/"><Icon name="globe"/><span>For business partners<small>Explore Mecosin services</small></span><Icon name="arrow"/></a><a href="/produk/"><Icon name="heart"/><span>For everyday wellbeing<small>Discover the portfolio</small></span><Icon name="arrow"/></a><div><b>1961</b><span>Our story begins</span></div><div><Icon name="leaf"/><span>Made in Indonesia</span></div><div><Icon name="flask"/><span>Product development</span></div><div><Icon name="globe"/><span>Business collaboration</span></div></div>}
</section>}
{section==='concerns' && <section class="ref-section ref-concerns" id="concerns" data-section="concerns"><div class="ref-wrap"><div class="ref-section-heading"><div><h2>{consumer?'Featured products':'Explore the Mecosin portfolio'}</h2><p>{consumer?'Two familiar Mecosin names, brought into focus. Explore the products, packaging and official information.':'Start with a familiar brand. Get to know its products.'}</p></div><a href="/produk/" class="ref-text-link">View all products <Icon name="arrow"/></a></div>{consumer ? <div class="consumer-featured-brands">{[
 {brand:'Laserin',headline:'Herbal products. A familiar name.',description:'Explore the Laserin range through original packaging and official product information. Take a closer look at Laserin Madu Orange and Laserin Sachet, then find the product details that help you compare the range.',slugs:['laserin-sachet','laserin-madu-orange']},
 {brand:'MecoVit',headline:'A closer look at everyday supplements.',description:'Get to know the MecoVit supplement range, from MecoVit-D3 1000 IU to MecoVit C Plus Zinc. Explore the packaging, product names and official label information before choosing which product you want to learn more about.',slugs:['mecovit-d3-1000-iu','mecovit-c-plus-zinc']}
 ].map(item=><article class={`consumer-brand-feature ${item.brand.toLowerCase()}`}><div class="consumer-feature-photo" style={`background-image:url(/images/design/featured-${item.brand.toLowerCase()}.webp)`}>{item.slugs.map(slug=>{const p=products.find(p=>p.slug===slug);return <img src={p.image} alt={p.name} width="640" height="640" loading="lazy"/>;})}</div><div class="consumer-feature-copy"><h3>{item.brand}</h3><h4>{item.headline}</h4><p>{item.description}</p><a class="ref-text-link" href={`/produk/?merek=${item.brand}`}>Lihat produk {item.brand}<Icon name="arrow"/></a></div></article>)}</div> : <div class="ref-concern-grid five">{concerns.slice(0,5).map(([name,desc,slug,photo],i)=><a class={`ref-concern concern-${i}`} href={`/produk/?merek=${encodeURIComponent(name)}`}><img src={photo} alt="Botanical and product imagery from Mecosin" width="500" height="320" loading="lazy"/><div><Icon name={['shield','leaf','heart','flask','globe','leaf'][i]}/><h3>{name}</h3><p>{desc}</p></div></a>)}</div>}</div></section>}
{section==='products' && <section class="ref-section ref-products" id="products" data-section="products"><div class="ref-wrap"><div class="ref-section-heading"><div><h2>{consumer?'Produk pilihan untuk keluarga':'Featured products'}</h2><p>Herbal products, supplements and body care from Mecosin.</p></div><a href="/produk/" class="ref-text-link">View all products <Icon name="arrow"/></a></div><div class="ref-product-grid">{featured.map(p=>consumer?<ProductCard product={p}/>:<article class="ref-product-card" data-featured-product={p.slug}><a href={`/produk/${p.slug}/`} class="ref-product-image"><img src={p.image} alt={p.name} width="640" height="640" loading="lazy"/></a><span class="ref-brand-name">{p.brand}</span><h3><a href={`/produk/${p.slug}/`}>{p.name}</a></h3><p>Official product information</p><div class="ref-product-action"><a href={`/produk/${p.slug}/`}>Explore product</a><a href={`/produk/${p.slug}/`} aria-label={`Explore ${p.name}`}><Icon name="arrow"/></a></div></article>)}</div>{consumer&&<p class="shop-sample-note">Harga, rating dan terjual adalah contoh desain, bukan data toko aktif.</p>}</div></section>}
{section==='trust' && <section class="ref-trust" data-section="trust"><div class="ref-wrap"><div><h2>{consumer?'Why people know Mecosin':'A familiar name. A lasting story.'}</h2><p>Get to know the company behind the products.</p></div><div class="ref-trust-marks">{[['1961','Company founded'],['Laserin','Herbal portfolio'],['MecoVit','Supplement range'],['Indonesia','Our home']].map(([label,caption],i)=><a href={i===0?'/about/':'/produk/'}><Icon name={['shield','leaf','flask','globe'][i]}/><b>{label}</b><span>{caption}</span></a>)}</div><div class="ref-trust-note"><Icon name="check"/><p>Product information.<br/>People behind the brand.<br/>A story to explore.</p></div></div></section>}
{section==='journey' && <section class="ref-journey" id="journey" data-section="journey"><div class="ref-journey-media"><img src="/images/design/forest.webp" alt="Forest imagery used on Mecosin's sustainability page" width="1440" height="250" loading="lazy"/><button class="ref-play" data-open-film aria-label="Watch Mecosin company introduction"><Icon name="play"/></button><span>Watch our company introduction</span></div><div class="ref-journey-copy"><p class="ref-eyebrow">From nature to product knowledge</p><h2>From Indonesian roots<br/>to everyday life.</h2><p>Discover the people, processes and product portfolio behind Mecosin Indonesia.</p><div class="ref-process-icons">{[['leaf','Botanical knowledge'],['flask','Product development'],['shield','Manufacturing'],['globe','Market services']].map(([icon,text])=><div><Icon name={icon}/><span>{text}</span></div>)}</div><div class="ref-actions"><a class="ref-btn gold" href="/about/">Explore our journey <Icon name="arrow"/></a><button class="ref-btn outline" data-open-film><Icon name="play"/>Watch company film</button></div></div></section>}
{section==='knowledge' && <section class="ref-section ref-knowledge" id="knowledge" data-section="knowledge"><div class="ref-wrap"><div class="ref-knowledge-intro"><h2>{business?'Explore our herbal knowledge':'Herbal knowledge'}</h2><p>Discover product information, company activities, and the people behind Mecosin.</p>{!business && <a class="ref-search-field" href="/artikel/">Explore articles<Icon name="search"/></a>}</div><a class="ref-knowledge-guide" href="/bantuan/"><Icon name="book"/><h3>Product knowledge<br/>at your fingertips</h3><p>Read information and find answers to common questions.</p></a><div class="ref-knowledge-cards">{knowledgeCards.slice(0,business?4:3).map(a=><a href={a.slug?`/artikel/${a.slug}/`:'/about/'}><img src={a.image} alt={a.title_en} width="600" height="350" loading="lazy"/><div><h3>{a.title_en}</h3><Icon name="arrow"/></div></a>)}</div></div></section>}
{section==='history' && <section class="ref-section ref-history" id="history" data-section="history"><div class="ref-wrap"><div class="ref-history-intro"><p class="ref-eyebrow">Mecosin Indonesia</p><h2>{consumer?<>Indonesian roots,<br/>closer to today.</>:<>A story of<br/>everyday care.<br/>Since 1961.</>}</h2><p>Mecosin's story brings together familiar products, people, and a continuing company journey.</p><a class="ref-btn gold" href="/about/">Explore our story <Icon name="arrow"/></a></div><div class="ref-milestones">{milestones.map(([year,label,image])=><a href="/about/"><img src={`/images/design/${image}.webp`} alt={label+' from Mecosin company history imagery'} width="1474" height="560" loading="lazy"/><span class="ref-timeline-dot"></span><b>{year}</b><span>{label}</span></a>)}</div></div></section>}
{section==='business' && <section class="ref-business" id="business" data-section="business"><div class="ref-wrap"><div class="ref-business-copy"><p class="ref-eyebrow">For business partners</p><h2>People. Products.<br/>Better partnerships.</h2><p>Explore manufacturing, product development, market management and importation with Mecosin.</p><div class="ref-actions"><a class="ref-btn gold" href="/kemitraan/">Explore business solutions <Icon name="arrow"/></a>{!consumer && <a class="ref-btn outline-light" href="/perusahaan/#kontak">Contact our team</a>}</div></div><div class="ref-business-cards">{capabilities.map(([name,desc,image])=><a href="/services/"><img src={image} alt={name+' imagery from Mecosin'} width="832" height="557" loading="lazy"/><div><h3>{name}</h3><p>{desc}</p></div></a>)}</div></div></section>}
{section==='partners' && <section class="ref-partners" data-section="partners"><div class="ref-wrap"><div><h2>{business?'Connections and collaboration':'People and partners behind the journey'}</h2><p>Discover Mecosin's partnerships and education activities.</p></div><div class="ref-partner-logos">{partners.map(([file,name])=><a href="/partners/"><img src={`/images/design/${file}.webp`} alt={name+' logo from Mecosin partner page'} width="300" height="240" loading="lazy"/></a>)}</div>{!business && <a class="ref-text-link" href="/partners/">Explore partnerships <Icon name="arrow"/></a>}</div></section>}
{section==='ingredients' && <section class="ref-section ref-ingredients" id="ingredients" data-section="ingredients"><div class="ref-wrap"><div class="ref-section-heading"><div><h2>Know what goes into the story.</h2><p>Look closer at botanicals, products and the work behind them.</p></div><a class="ref-text-link" href="/bantuan/">Explore product information <Icon name="arrow"/></a></div><div class="ref-ingredient-grid">{[['Herbal ingredients','/images/design/herbs.webp','Explore the herbal imagery and official product labels.'],['Ginger','/images/ginger.webp','A familiar botanical in Mecosin product information.'],['Botanical selection','/images/design/sourcing.webp','Discover the production story through Mecosin imagery.'],['Product knowledge','/images/botanical.webp','Read the information on each product page.']].map(([name,image,text])=><a href="/bantuan/"><img src={image} alt={name+' from Mecosin imagery'} width="600" height="360" loading="lazy"/><div><h3>{name}</h3><small>Look closer</small><p>{text}</p><span>Learn more <Icon name="arrow"/></span></div></a>)}</div></div></section>}
{section==='confidence' && <section class="ref-section ref-confidence" data-section="confidence"><div class="ref-wrap"><div><h2>From questions to information.</h2><div class="ref-confidence-steps">{[['Find the product','Start with a brand or product name.'],['Read its information','Explore the catalogue and source labels.'],['Ask the right person','Contact Mecosin or a healthcare professional.']].map(([title,text],i)=><div><b>{i+1}</b><Icon name={['search','book','person'][i]}/><article><h3>{title}</h3><p>{text}</p></article></div>)}</div></div><AskMecosinCard compact /></div></section>}
{section==='guide' && <section class="ref-section ref-guides" data-section="guide"><div class="ref-wrap"><div class="ref-section-heading"><h2>Featured stories</h2><a class="ref-text-link" href="/artikel/">Visit our articles <Icon name="arrow"/></a></div><div class="ref-guide-grid"><a class="ref-guide-large" href="/about/"><img src="/images/design/herbs.webp" alt="Herbal materials from Mecosin" width="1000" height="971" loading="lazy"/><div><small>Our story</small><h3>Herbal roots.<br/>A continuing journey.</h3><span>Explore Mecosin <Icon name="arrow"/></span></div></a><div class="ref-guide-small">{articles.map(a=><a href={`/artikel/${a.slug}/`}><img src={a.image} alt={a.title_en} width="600" height="350" loading="lazy"/><div><small>Mecosin activities</small><h3>{a.title_en}</h3><span>Read story <Icon name="arrow"/></span></div></a>)}</div></div></div></section>}
{section==='transparency' && <section class="ref-transparency" id="transparency" data-section="transparency"><div class="ref-wrap"><div><h2>Real products.<br/>A closer look.</h2><p>Get to know the packaging, labels and information in Mecosin's product portfolio.</p><a class="ref-btn outline" href="/produk/">Explore the product range <Icon name="arrow"/></a></div><div class="ref-transparency-products"><img class="ref-transparency-botanical" src="/images/botanical.webp" alt="Botanical imagery from Mecosin" width="1439" height="744" loading="lazy"/>{transparencyProducts.map(p=><img src={p.image} alt={p.name} width="640" height="640" loading="lazy"/>)}</div><ul>{['Product names and packaging','Official catalogue information','Product label references','Clear purchase channels','Contacts for your questions'].map(text=><li><Icon name="check"/>{text}</li>)}</ul></div></section>}
{section==='rewards' && <section class="ref-rewards" data-section="rewards"><div class="ref-wrap"><Icon name="gift"/><div><h2>More to discover. More to know.</h2><p>Explore the portfolio, follow company stories and get to know Mecosin.</p></div><a class="ref-btn" href="/produk/">Explore now <Icon name="arrow"/></a></div></section>}
{section==='sustainability' && <section class="ref-section ref-sustainability" data-section="sustainability"><div class="ref-wrap"><div class="ref-sustainability-copy"><p class="ref-eyebrow">People, products and responsibility</p><h2>{business?'Sustainability & responsible growth':'People, plants, and a shared tomorrow.'}</h2><p>Explore the environmental, social and governance themes in Mecosin's company story.</p><a class="ref-btn outline" href="/discoveries/">Our sustainability journey <Icon name="arrow"/></a></div><div class="ref-sustainability-image"><img src={business?'/images/design/community.webp':'/images/design/forest.webp'} alt={business?'Mecosin community activity':'Forest imagery from Mecosin sustainability page'} width="1440" height="800" loading="lazy"/><div class="ref-sustainability-points">{[['leaf','Environmental care'],['person','Community activities'],['shield','Responsible processes']].map(([icon,text])=><a href="/discoveries/"><Icon name={icon}/><h3>{text}</h3><p>Explore the Mecosin story.</p></a>)}</div></div></div></section>}
{section==='capabilities' && <section class="ref-section ref-capabilities" id="capabilities" data-section="capabilities"><div class="ref-wrap"><div class="ref-section-heading"><div><h2>Built for partnership</h2><p>Explore services to support your product and business needs.</p></div><a class="ref-text-link" href="/services/">View all services <Icon name="arrow"/></a></div><div class="ref-capability-grid">{capabilities.map(([name,desc,image])=><a href="/services/"><img src={image} alt={name+' from Mecosin source imagery'} width="832" height="557" loading="lazy"/><div><h3>{name}</h3><p>{desc}</p><Icon name="arrow"/></div></a>)}</div></div></section>}
{section==='why' && <section class="ref-section ref-why" data-section="why"><div class="ref-wrap"><figure><img src="/images/team.webp" alt="Mecosin company team" width="1500" height="1005" loading="lazy"/></figure><div><h2>Why get to know Mecosin</h2><p>A company story that combines herbal products, supplements, manufacturing services and the people behind familiar brands.</p><div class="ref-stat-grid"><div><b>1961</b><span>Our story begins</span></div><div><b>Laserin</b><span>A familiar herbal brand</span></div><div><b>MecoVit</b><span>Supplement portfolio</span></div><div><b>Indonesia</b><span>Company roots</span></div></div><div class="ref-why-marks"><a href="/about/"><Icon name="shield"/>Company story</a><a href="/services/"><Icon name="flask"/>Manufacturing</a><a href="/team/"><Icon name="person"/>Our people</a></div></div></div></section>}
{section==='process' && <section class="ref-section ref-process" data-section="process"><div class="ref-wrap"><div class="ref-section-heading"><div><h2>From a conversation to the next step</h2><p>Topics to explore with Mecosin's business team.</p></div></div><div class="ref-process-line">{steps.map(([title,text],i)=><article><span>{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>}
{section==='quality' && <section class="ref-section ref-quality" id="quality" data-section="quality"><div class="ref-wrap"><div><h2>Research, products<br/>and people.</h2><p>Look inside Mecosin's company imagery: from botanical materials to laboratories and manufacturing.</p><a class="ref-btn gold" href="/services/">Explore our services <Icon name="arrow"/></a></div><div class="ref-quality-grid">{[['sourcing','Botanical materials'],['scientist','Laboratory work'],['bottling','Production processes'],['production','Manufacturing']].map(([image,text])=><a href="/services/"><img src={`/images/design/${image}.webp`} alt={text+' at Mecosin'} width="600" height="800" loading="lazy"/><span>{text}<Icon name="arrow"/></span></a>)}</div></div></section>}
{section==='expertise' && <section class="ref-section ref-expertise" id="products" data-section="expertise"><div class="ref-wrap"><div class="ref-section-heading"><div><h2>Our product portfolio</h2><p>Get to know the brands and products in Mecosin's catalogue.</p></div><a class="ref-text-link" href="/produk/">View all products <Icon name="arrow"/></a></div><div class="ref-expertise-grid">{concerns.map(([name,text,slug])=><a href={`/produk/?merek=${encodeURIComponent(name)}`}><img src={products.find(p=>p.slug===slug).image} alt={name} width="640" height="640" loading="lazy"/><h3>{name}</h3></a>)}</div></div></section>}
{section==='tour' && <section class="ref-tour" data-section="tour"><div class="ref-wrap"><div><p class="ref-eyebrow">Mecosin Indonesia</p><h2>A closer look<br/>at our company.</h2><p>Discover the products, people and processes in Mecosin's company introduction.</p><button class="ref-film-link" data-open-film><span><Icon name="play"/></span>Watch company introduction</button></div><img src="/images/design/production.webp" alt="Mecosin manufacturing source photograph" width="1440" height="1220" loading="lazy"/><button class="ref-tour-card" data-open-film><Icon name="play"/><b>Meet Mecosin</b><span>Explore the company film</span></button></div></section>}
{section==='inquiry' && <section class="ref-inquiry" data-section="inquiry"><div class="ref-wrap"><div><p class="ref-eyebrow">Start a conversation</p><h2>Let's explore your<br/>next product together.</h2><p>Tell Mecosin about your product category, business needs and target market.</p><a class="ref-btn gold" href="/kemitraan/">Explore partnership <Icon name="arrow"/></a><div class="ref-inquiry-links"><a href="/about/">Company story</a><a href="/services/">View services</a></div></div><form data-local-inquiry method="dialog"><h3>Prepare your inquiry</h3><div><label>Name<input name="name" required autocomplete="name"/></label><label>Company<input name="company" required autocomplete="organization"/></label></div><div><label>Business interest<select name="interest"><option>Manufacturing</option><option>Product development</option><option>Market management</option><option>Importation</option></select></label><label>Market<input name="market"/></label></div><label>Message<textarea name="message" rows="3" required></textarea></label><button class="ref-btn" type="submit">Review inquiry <Icon name="arrow"/></button><p class="ref-fine" role="status">This form stays on this page. Contact Mecosin to send your inquiry.</p></form><div class="ref-inquiry-tagline"><Icon name="leaf"/><p>Better conversations.<br/>Stronger partnerships.</p></div></div></section>}
