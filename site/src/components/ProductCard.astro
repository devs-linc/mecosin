---
import Rating from './Rating.astro';
import '../styles/shopping.css';
const { product } = Astro.props;
---
<article class="product" data-product data-brand={product.brand} data-name={`${product.name} ${product.excerpt}`.toLowerCase()} data-need={/daya tahan/i.test(product.excerpt) ? 'immune' : /tulang|Gigi/i.test(product.excerpt) ? 'bone' : /kulit|body/i.test(product.excerpt) ? 'body' : /batuk|tenggorokan/i.test(product.excerpt) ? 'throat' : 'other'}>
  <a class="shop-product-link" href={`/produk/${product.slug}/`}><div class="product-image"><img src={product.image} alt={product.name} width="640" height="640" loading="lazy" /></div><h3>{product.name}</h3></a>
  <div class="shop-card-info"><strong class="shop-price">Rp25.000</strong><Rating /><button class="shop-button" data-add={product.slug} disabled>Tambah ke keranjang</button></div>
</article>
