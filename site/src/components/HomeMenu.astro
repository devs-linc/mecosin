---
const homepages = [['/design/hybrid/', 'Homepage 1'], ['/design/consumer/', 'Homepage 2'], ['/design/business/', 'Homepage 3']];
---
<details class="home-nav">
  <summary>Home <span aria-hidden="true">⌄</span></summary>
  <div class="home-menu">{homepages.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}<span aria-hidden="true">↗</span></a>)}</div>
</details>
<style>
.home-nav{position:relative;flex:none}.home-nav summary{display:flex;align-items:center;gap:10px;min-height:48px;list-style:none;cursor:pointer;white-space:nowrap}.home-nav summary::-webkit-details-marker{display:none}.home-menu{position:absolute;top:100%;left:-18px;z-index:40;width:205px;padding:10px 18px;background:#fff;color:#213d32;border:1px solid #dce5dc;border-radius:0 0 10px 10px;box-shadow:0 16px 32px #213d3218}.home-menu a{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:48px;font-size:14px;border-bottom:1px solid #dce5dc}.home-menu a:last-child{border-bottom:0}.home-menu a[aria-current=page]{font-weight:700;color:#17613f}.home-menu a:hover{color:#17613f}.home-nav summary:focus-visible,.home-menu a:focus-visible{outline:3px solid #9c4a14;outline-offset:3px}
@media(max-width:760px){.home-nav{width:100%}.home-nav summary{justify-content:space-between;min-height:54px;font-size:16px;border-bottom:1px solid #dce5dc}.home-menu{position:static;width:auto;padding:0 0 12px 18px;border:0;box-shadow:none;border-radius:0}.home-menu a{font-size:14px}}
</style>
<script>
document.querySelectorAll<HTMLDetailsElement>('.home-nav').forEach(menu => {
  menu.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu.open) {
      event.stopPropagation(); menu.open = false; menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', event => {
    if (!(event.target instanceof Node) || !menu.contains(event.target)) menu.open = false;
  });
  menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
});
</script>
