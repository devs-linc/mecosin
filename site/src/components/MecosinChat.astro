---
import Icon from './ReferenceIcon.astro';
---
<button class="mecosin-chat-launcher" type="button" data-open-chat aria-label="Open Ask Mecosin" aria-haspopup="dialog" aria-controls="mecosin-chat" hidden><Icon name="leaf"/><span>Ask Mecosin</span></button>
<dialog id="mecosin-chat" aria-labelledby="mecosin-chat-title">
  <header class="mecosin-chat-head"><img class="chat-avatar" src="/images/chat-avatar.svg" alt="" width="44" height="44"/><div><h2 id="mecosin-chat-title">Ask Mecosin</h2><p>Temukan produk pilihanmu</p></div><button type="button" data-close-chat aria-label="Close Ask Mecosin">×</button></header>
  <div class="mecosin-chat-messages" role="log" aria-live="polite" aria-relevant="additions"><p class="mecosin-chat-reply">Hai, selamat datang! Ada yang bisa aku bantu?</p></div>
  <div id="mecosin-chat-typing" role="status" hidden><img src="/images/chat-avatar.svg" alt="" width="28" height="28"/><span>Sedang mengetik</span><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div>
  <form id="mecosin-chat-form" method="dialog"><label class="chat-sr-only" for="mecosin-chat-input">Your question</label><input id="mecosin-chat-input" name="question" placeholder="Tulis pesanmu…" maxlength="500" autocomplete="off"/><button type="submit" aria-label="Send question"><Icon name="arrow"/></button></form>
  <p class="mecosin-chat-note">Pesan diproses melalui penyedia layanan. Jangan kirim data pribadi atau rekam medis.</p>
  <p id="mecosin-chat-status" role="status" class="mecosin-chat-note"></p>
</dialog>
<style>
.mecosin-chat-launcher[hidden]{display:none}.mecosin-chat-launcher{position:fixed;right:22px;bottom:20px;z-index:35;display:flex;align-items:center;gap:10px;min-height:48px;padding:10px 18px;border:0;border-radius:30px;background:#356843;color:white;box-shadow:0 6px 22px #14382730;font-size:13px}.mecosin-chat-launcher svg{width:22px;height:22px}#mecosin-chat{position:fixed;inset:auto 22px 20px auto;margin:0;width:380px;max-width:calc(100vw - 24px);height:640px;max-height:calc(100dvh - 40px);padding:0;border:1px solid #c9d7c1;border-radius:18px;background:#fbfcf6;color:#243c30;box-shadow:0 12px 50px #17352730;overflow:hidden}#mecosin-chat[open]{display:flex;flex-direction:column}#mecosin-chat::backdrop{background:#153d2418}.mecosin-chat-head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px;background:#356843;color:white}.mecosin-chat-head p{font-size:11px;color:#d7e6d1}.mecosin-chat-head h2{font:600 24px/1.2 Arial;margin-top:4px}.mecosin-chat-head button{width:44px;height:44px;border:0;background:transparent;color:white;font-size:28px}.mecosin-chat-messages{flex:1;min-height:80px;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:12px}.mecosin-chat-messages :global(.mecosin-chat-reply),.mecosin-chat-messages :global(.mecosin-chat-user){flex:none;margin:0;padding:12px 14px;border-radius:12px;font-size:13px;line-height:1.6;background:white;border:1px solid #dde5d7;white-space:pre-wrap}.mecosin-chat-messages :global(.mecosin-chat-user){background:#e6efdf;align-self:flex-end;max-width:90%}.mecosin-chat-messages :global(.mecosin-chat-reply a){display:block;min-height:44px;padding-top:10px;color:#356843;font-weight:600;text-decoration:underline}.mecosin-chat-topics{display:flex;flex-wrap:wrap;gap:6px;padding:10px 18px}.mecosin-chat-topics button{min-height:36px;border:1px solid #c6d6bc;background:#f3f7ed;border-radius:20px;padding:7px 12px;font-size:12px}.mecosin-chat-product{display:grid;gap:5px;padding:0 18px 12px;font-size:11px}.mecosin-chat-product select{width:100%;min-height:42px;border:1px solid #c6d6bc;border-radius:8px;background:white;padding:8px 12px;font-size:12px}#mecosin-chat-form{display:flex;gap:8px;padding:12px 18px;border-top:1px solid #dce5d4}#mecosin-chat-input{flex:1;min-width:0;min-height:44px;border:1px solid #c6d6bc;border-radius:9px;padding:10px 12px;font-size:13px;background:white}#mecosin-chat-form button{width:44px;height:44px;border:0;border-radius:50%;background:#356843;color:white;display:grid;place-items:center}#mecosin-chat-form svg{width:19px;height:19px}.mecosin-chat-note{font-size:10px;line-height:1.5;color:#5a6d51;padding:0 18px 14px}.chat-sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(max-width:480px){#mecosin-chat{inset:auto 12px 12px auto;width:calc(100vw - 24px);max-height:calc(100dvh - 24px);height:650px}.mecosin-chat-launcher{right:14px;bottom:14px}.mecosin-chat-head{padding:16px}.mecosin-chat-messages{padding:14px}}
#mecosin-chat .chat-avatar{border-radius:50%;flex:none;background:#e5eadc}.mecosin-chat-head>div{flex:1}.mecosin-chat-head{gap:12px}.mecosin-chat-head p{margin-top:5px}
#mecosin-chat-typing[hidden]{display:none}#mecosin-chat-typing{display:flex;align-items:center;gap:5px;padding:10px 18px;color:#356843;font-size:12px;flex:none}#mecosin-chat-typing img{border-radius:50%;margin-right:5px}#mecosin-chat-typing>span:first-of-type{margin-right:6px}.typing-dot{width:5px;height:5px;border-radius:50%;background:currentColor;animation:chat-typing 1.2s ease-in-out infinite}.typing-dot:nth-last-child(2){animation-delay:.15s}.typing-dot:last-child{animation-delay:.3s}@keyframes chat-typing{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-4px);opacity:1}}@media(prefers-reduced-motion:reduce){.typing-dot{animation:none;opacity:1}}#mecosin-chat-status:empty{display:none}#mecosin-chat-form button:disabled{opacity:.55}.mecosin-chat-note{font-size:11px}
.mecosin-chat-messages :global(a.chat-product-card){display:flex;gap:12px;align-items:flex-start;margin-top:12px;padding:12px 0 0;border-top:1px solid #dce5d4;text-decoration:none;color:#243c30;font-weight:400;white-space:normal}.mecosin-chat-messages :global(.chat-product-card img){flex:none;width:72px;height:84px;object-fit:contain;background:#f5f7f0;border-radius:8px}.mecosin-chat-messages :global(.chat-product-card>span){display:grid;gap:6px;min-width:0}.mecosin-chat-messages :global(.chat-product-card strong){font-size:14px}.mecosin-chat-messages :global(.chat-product-card small){color:#52634c;font-size:11px}.mecosin-chat-messages :global(.chat-product-action){color:#356843;text-decoration:underline;font-weight:600}
</style>
<script>
document.querySelector<HTMLButtonElement>('.mecosin-chat-launcher')?.removeAttribute('hidden');
const dialog=document.querySelector<HTMLDialogElement>('#mecosin-chat');
const log=dialog?.querySelector<HTMLElement>('.mecosin-chat-messages');
const input=dialog?.querySelector<HTMLInputElement>('#mecosin-chat-input');
const typing=dialog?.querySelector<HTMLElement>('#mecosin-chat-typing');
let opener:HTMLElement|null=null;
function add(text:string,user=false,href?:string){if(!log)return;const bubble=document.createElement('p');bubble.className=user?'mecosin-chat-user':'mecosin-chat-reply';bubble.textContent=text;if(href){const link=document.createElement('a');link.href=href;link.textContent=' Explore more ↗';bubble.append(link);}log.append(bubble);while(log.children.length>16)log.firstElementChild?.remove();log.scrollTop=log.scrollHeight;}
const status=dialog?.querySelector<HTMLElement>('#mecosin-chat-status');
let busy=false;
let history:{role:string;content:string}[]=[];
async function send(question:string){
 if(busy||!question.trim()||question.length>500)return;
 busy=true;add(question,true);if(input)input.value='';if(typing)typing.hidden=false;
 const controls=dialog?.querySelectorAll<HTMLButtonElement|HTMLInputElement|HTMLSelectElement>('form button,form input');
 controls?.forEach(control=>control.disabled=true);
 if(status)status.textContent='';
 log?.setAttribute('aria-busy','true');
 try{
  const messages=[...history.slice(-10),{role:'user',content:question}];
  const response=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages}),signal:AbortSignal.timeout(25000)});
  const data=await response.json();
  if(!response.ok)throw new Error(typeof data.error==='string'?data.error:'Chat belum tersedia. Coba lagi nanti.');
  if(typeof data.reply!=='string'||!Array.isArray(data.sources))throw new Error('Jawaban belum tersedia. Coba lagi nanti.');
  add(data.reply);
  for(const source of data.sources){
   try{const url=new URL(source.url);if(url.protocol==='https:'&&!url.username&&!url.password&&['mecosin.id','www.halodoc.com','www.k24klik.com','medicastore.com','www.hbhoz.id','javanesetaste.com','rm.id'].includes(url.host)){
    const card=document.createElement('a');card.className='chat-product-card';card.href=url.href;card.target='_blank';card.rel='noopener noreferrer';
    if(typeof source.image==='string'&&/^\/images\/[a-z0-9-]+\.webp$/.test(source.image)){const image=document.createElement('img');image.src=source.image;image.alt=source.name;image.width=72;image.height=84;card.append(image);}
    const details=document.createElement('span');const name=document.createElement('strong');name.textContent=source.name;
    const description=document.createElement('span');description.textContent=source.description||'Lihat informasi produk selengkapnya.';
    const action=document.createElement('span');action.className='chat-product-action';action.textContent='Lihat produk / sumber ↗';
    const origin=document.createElement('small');origin.textContent=url.hostname.replace(/^www\./,'');details.append(name,description,action,origin);card.append(details);log?.lastElementChild?.append(card);
   }}catch{}
  }
  history=[...messages,{role:'assistant',content:(data.reply+(data.sources.length?'\nProduk yang ditampilkan: '+data.sources.map((s:{name:string})=>s.name).join(', '):'')).slice(0,1600)}].slice(-10);
  if(status)status.textContent='';
 }catch(error){
  const message=error instanceof Error&&error.name!=='TimeoutError'&&error.name!=='TypeError'?error.message:'Koneksi chat bermasalah. Coba kirim lagi, ya.';
  add(message);if(status)status.textContent='Pesan belum diproses. Kamu bisa mencoba lagi.';
 }finally{
  busy=false;if(typing)typing.hidden=true;controls?.forEach(control=>control.disabled=false);log?.setAttribute('aria-busy','false');
  if(log)log.scrollTop=log.scrollHeight;if(dialog?.open)input?.focus();
 }
}
document.querySelectorAll<HTMLElement>('[data-open-chat]').forEach(button=>button.addEventListener('click',event=>{event.preventDefault();if(!dialog)return;opener=button;if(!dialog.open)dialog.showModal();const topic=button.dataset.chatTopic;if(topic&&input)input.value=topic==='Products'?'Aku ingin tahu produk Mecosin':topic==='Ingredients'?'Aku ingin tahu komposisi produk Mecosin':topic==='Buying'?'Bagaimana membeli produk Mecosin?':'Bagaimana menghubungi Mecosin?';input?.focus();}));
dialog?.querySelector('[data-close-chat]')?.addEventListener('click',()=>dialog.close());
dialog?.addEventListener('close',()=>opener?.focus());
dialog?.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
dialog?.querySelector('form')?.addEventListener('submit',event=>{event.preventDefault();const question=input?.value.trim();if(question)void send(question);});
// Opening a topic from outside only pre-fills; disclosure stays visible before sending.

</script>
