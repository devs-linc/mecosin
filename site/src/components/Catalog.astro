---
import products from '../data/products.json';
import ProductCard from './ProductCard.astro';
import '../styles/approved-home.css';

const brands = ['Laserin','MecoVit','Lancar ASI','Mecowell','Herbatusauda','Beauty 360'];
---
<section id="katalog" class="catalog section-wrap shop-catalog">
<div class="catalog-tools" hidden>
<label class="search-label shop-search">Cari produk Mecosin<input id="product-search" type="search" maxlength="120" autocomplete="off" placeholder="Nama produk atau brand" /></label>
<details class="shop-filters" open><summary>Filter produk</summary><div>
<label class="search-label">Brand<select id="brand-filter"><option value="">Semua brand</option>{brands.map(b=><option>{b}</option>)}</select></label>
<label class="search-label">Kategori informasi<select id="need-filter"><option value="">Semua kategori</option><option value="immune">Daya tahan tubuh</option><option value="bone">Tulang &amp; gigi</option><option value="body">Perawatan tubuh</option><option value="throat">Informasi batuk &amp; tenggorokan</option><option value="other">Lainnya</option></select></label>
<label class="search-label">Harga minimum<input id="price-min" type="number" min="0" max="100000000" placeholder="Rp" /></label>
<label class="search-label">Harga maksimum<input id="price-max" type="number" min="0" max="100000000" placeholder="Rp" /></label>
<button class="shop-button outline" id="reset-catalog" type="button">Reset filter</button>
</div></details>
<label class="search-label">Urutkan<select id="product-sort"><option value="recommended">Rekomendasi</option><option value="low">Harga terendah</option><option value="high">Harga tertinggi</option><option value="name">Nama A–Z</option></select></label>
</div>
<div class="catalog-status"><h2>Semua produk</h2><p id="result-count" role="status">20 produk</p></div>
<div class="product-grid">{products.map(product=><ProductCard product={product} />)}</div>
<p class="empty-state" hidden>Tidak ada hasil. Coba kata lain atau reset filter.</p>
<p class="shop-sample-note">Harga, rating dan jumlah terjual adalah contoh desain. Stok belum terhubung. Kategori bukan rekomendasi medis.</p>
</section>
